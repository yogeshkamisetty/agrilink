# AgriLink Environment Variables
# Copy this file to .env.local and fill in the values.

# ── AGMARKNET live prices (data.gov.in) ──────────────────────────────────
# Free API key from https://data.gov.in/
DATA_GOV_IN_API_KEY=
PILOT_STATE=Gujarat

# ── DoCA retail prices (optional) ────────────────────────────────────────
# Set once the data.gov.in resource ID for DoCA Price Monitoring is confirmed.
DOCA_RESOURCE_ID=
DOCA_CENTRE=Ahmedabad

# ── AI / Vision ──────────────────────────────────────────────────────────
# Vercel AI Gateway key, or leave blank to use manual grading fallback.
AI_GATEWAY_API_KEY=
AGRILINK_AI_MODEL=google/gemini-2.0-flash
AGRILINK_VISION_MODEL=google/gemini-2.0-flash

# ── Cascade timing ───────────────────────────────────────────────────────
# Real seconds per cascade "hour". 3600 for production; 1 for demo (12-hour
# cascade in 12 seconds).
CASCADE_SECONDS_PER_HOUR=1

# ── WhatsApp Cloud API (optional) ────────────────────────────────────────
# One real message per order, sent to the team's test phone.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEST_PHONE=

# ── Database ─────────────────────────────────────────────────────────────
# Postgres URL (Supabase transaction pooler, port 6543).
# Leave blank to use PGlite (embedded, file-based — zero setup).
DATABASE_URL=

# Allow destructive schema reset on remote Postgres (never in production).
AGRILINK_ALLOW_RESET=false

# Local PGlite data directory (default: .data/pglite in project root).
# AGRILINK_DATA_DIR=

# ── 2Factor.in SMS Authentication (Free Tier / Trial) ───────────────────
# Free trial credits (~100 to 250 free SMS) from https://2factor.in/
# If left blank, AgriLink automatically operates in Free Demo Mode with on-screen OTPs.
TWOFACTOR_API_KEY=

# ── Supabase identity verification ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Long random value used to hash OTPs. Required in production.
IDENTITY_OTP_SECRET=
# Your SMS-service adapter receives { mobile, otp, purpose }. Required in production.
IDENTITY_OTP_WEBHOOK_URL=

